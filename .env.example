# Copy to .env and fill in. Nothing here has a safe default for a real
# deployment -- the blanks below are exactly the values docker-compose.yml
# has no sensible default for.

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Wikimedia batch source (services/batch_extract)
PAGEVIEWS_PROJECT=en.wikipedia
PAGEVIEWS_ACCESS=all-access
BATCH_POLL_INTERVAL_HOURS=24

# Parquet buffer retention (orchestration cleanup job)
PARQUET_RETENTION_DAYS=3

# Kafka/Redpanda topic the bridge writes to and landing reads from
KAFKA_TOPIC=wikipedia.recentchange
STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange

# How long Redpanda retains the topic before dropping old messages, and a
# hard size cap regardless of age (a redpanda-init step applies these on
# startup, creating the topic if needed or altering it if it already
# exists). This is only a buffer between the bridge (producer) and landing
# (consumer, near-real-time) -- once landing has written an event to
# Parquet it doesn't need to stay in Redpanda, so this only needs to cover
# "landing was down for a while", not long-term storage. Left at the
# Kafka/Redpanda default (7 days, unbounded bytes) this can outgrow a
# small host fast on an unfiltered global firehose -- found running this
# for real (see README.md's "Lessons from the first live deploy"). These
# defaults favor a small host over a large safety margin; raise them if
# you have the disk and want more slack for extended landing downtime.
KAFKA_TOPIC_RETENTION_MS=21600000
KAFKA_TOPIC_RETENTION_BYTES=2147483648

# How old (in seconds) a stored bridge checkpoint can be before it's
# treated as unusable and discarded on reconnect (resumes from "now"
# instead). Protects against a large Wikimedia backlog replay after
# extended downtime -- an SSE resume with a stale Last-Event-ID asks the
# source to replay everything missed, which for an unfiltered firehose
# can mean hours of events delivered in a burst. Has a safe default
# (900s / 15min); only set this if you need a different tradeoff between
# "small gap in the data" and "how much backlog is acceptable to replay".
MAX_CHECKPOINT_AGE_SECONDS=900

# Your existing Loki's push endpoint -- Alloy ships container logs here.
# No default: this is yours. (Metrics are scraped by your own Prometheus
# directly from ClickHouse/Redpanda, not pushed through Alloy -- see
# observability/README.md.)
LOKI_ENDPOINT_URL=
