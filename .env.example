# Copy to .env and fill in. Nothing here has a safe default for a real
# deployment -- the blanks below are exactly the values docker-compose.yml
# has no sensible default for.

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Wikimedia batch source (services/batch_extract)
PAGEVIEWS_PROJECT=en.wikipedia
PAGEVIEWS_ACCESS=all-access
BATCH_POLL_INTERVAL_HOURS=24

# Parquet buffer retention (orchestration cleanup job)
PARQUET_RETENTION_DAYS=3

# Kafka/Redpanda topic the bridge writes to and landing reads from
KAFKA_TOPIC=wikipedia.recentchange
STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange

# Your existing Loki's push endpoint -- Alloy ships container logs here.
# No default: this is yours. (Metrics are scraped by your own Prometheus
# directly from ClickHouse/Redpanda, not pushed through Alloy -- see
# observability/README.md.)
LOKI_ENDPOINT_URL=
