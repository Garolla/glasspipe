// Grafana Alloy config: ships container logs to whatever Loki you already
// have running (push -- Loki accepts this natively). Deliberately does
// NOT push metrics to Prometheus: vanilla Prometheus is pull-based by
// default (no remote-write receiver unless the deployer explicitly
// enabled one), so assuming push support here would be presumptuous
// about a setup this file has no way to know about. Point your own
// Prometheus at ClickHouse's (`:9363/metrics`) and Redpanda's
// (`:9644/public_metrics`) endpoints directly -- that's the deployer's
// own scrape_configs, out of scope for this file. See
// observability/README.md.

logging {
  level = "info"
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = env("LOKI_ENDPOINT_URL")
  }
}
